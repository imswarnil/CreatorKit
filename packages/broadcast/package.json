{
	"name": "@creatorkit/broadcast",
	"version": "0.1.0",
	"description": "Thumbnails, scenes, lower thirds and stream overlays \u2014 the layer that ships to YouTube and Instagram, never to a website.",
	"keywords": [
		"creator-tools",
		"creators",
		"design-system",
		"instagram",
		"obs",
		"stream-overlay",
		"thumbnail",
		"youtube"
	],
	"homepage": "https://creator.imswarnil.com",
	"bugs": "https://github.com/imswarnil/CreatorKit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imswarnil/CreatorKit.git",
		"directory": "packages/broadcast"
	},
	"license": "MIT",
	"author": {
		"name": "Swarnil",
		"url": "https://imswarnil.com"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./css": "./dist/broadcast.css",
		"./min": "./dist/broadcast.min.css",
		"./dist/broadcast.css": "./dist/broadcast.css",
		"./package.json": "./package.json"
	},
	"files": [
		"INVENTORY.md",
		"README.md",
		"dist",
		"src",
		"styles"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && postcss styles/index.css -o dist/broadcast.css && NODE_ENV=production postcss styles/index.css -o dist/broadcast.min.css && node ../../tools/css-inventory/index.mjs styles INVENTORY.md \"@creatorkit/broadcast\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\" 2>/dev/null || echo 'no tests yet'",
		"clean": "rm -rf dist .turbo *.tsbuildinfo"
	},
	"dependencies": {
		"@creatorkit/tokens": "workspace:*"
	}
}
