{
	"name": "@creatorkit/tokens",
	"version": "0.1.0",
	"description": "Design tokens for CreatorKit \u2014 one source, emitted as a Tailwind preset, CSS custom properties and typed JS.",
	"keywords": [
		"design-tokens",
		"tailwind",
		"css-variables",
		"oklch"
	],
	"homepage": "https://creator.imswarnil.com",
	"bugs": "https://github.com/imswarnil/CreatorKit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imswarnil/CreatorKit.git",
		"directory": "packages/tokens"
	},
	"license": "MIT",
	"author": {
		"name": "Swarnil",
		"url": "https://imswarnil.com"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./css": "./dist/tokens.css",
		"./min": "./dist/tokens.min.css",
		"./tailwind": "./dist/tailwind.js",
		"./json": "./dist/tokens.json",
		"./dist/tokens.css": "./dist/tokens.css",
		"./dist/tailwind.js": "./dist/tailwind.js",
		"./styles/*": "./styles/*",
		"./package.json": "./package.json",
		"./dist/tokens.json": "./dist/tokens.json"
	},
	"files": [
		"INVENTORY-CSS.md",
		"README.md",
		"TOKENS.md",
		"dist",
		"src",
		"styles"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && postcss styles/index.css -o dist/tokens.css && NODE_ENV=production postcss styles/index.css -o dist/tokens.min.css && node scripts/build-outputs.mjs && node ../../tools/css-inventory/index.mjs styles INVENTORY-CSS.md \"@creatorkit/tokens \u2014 foundation rules\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\" 2>/dev/null || echo 'no tests yet'",
		"clean": "rm -rf dist .turbo *.tsbuildinfo"
	}
}
