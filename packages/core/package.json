{
	"name": "@creatorkit/core",
	"version": "0.1.0",
	"description": "CreatorKit base layer \u2014 reset, focus ring, layout primitives and the cn() helper.",
	"keywords": [
		"design-system",
		"tailwind",
		"react"
	],
	"homepage": "https://creator.imswarnil.com",
	"bugs": "https://github.com/imswarnil/CreatorKit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imswarnil/CreatorKit.git",
		"directory": "packages/core"
	},
	"license": "MIT",
	"author": {
		"name": "Swarnil",
		"url": "https://imswarnil.com"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./css": "./dist/core.css",
		"./min": "./dist/core.min.css",
		"./base": "./styles/base.css",
		"./foundation": "./styles/foundation/index.css",
		"./utilities": "./styles/utilities/index.css",
		"./dist/core.css": "./dist/core.css",
		"./package.json": "./package.json"
	},
	"files": [
		"INVENTORY.md",
		"README.md",
		"dist",
		"src",
		"styles"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && postcss styles/index.css -o dist/core.css && NODE_ENV=production postcss styles/index.css -o dist/core.min.css && node ../../tools/css-inventory/index.mjs styles INVENTORY.md \"@creatorkit/core \u2014 utilities\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "node --test dist/cn.test.js",
		"clean": "rm -rf dist .turbo *.tsbuildinfo"
	},
	"dependencies": {
		"@creatorkit/tokens": "workspace:*",
		"clsx": "^2.1.1",
		"tailwind-merge": "^2.5.0"
	},
	"peerDependencies": {
		"react": ">=18"
	}
}
