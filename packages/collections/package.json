{
	"name": "@creatorkit/collections",
	"version": "0.1.0",
	"description": "Creator content types — video, course, episode, project, travel, prompt, snippet and the rest, as components and Ghost-ready classes.",
	"keywords": ["creator-tools", "ghost-theme", "content-types"],
	"homepage": "https://creator.imswarnil.com",
	"bugs": "https://github.com/imswarnil/CreatorKit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imswarnil/CreatorKit.git",
		"directory": "packages/collections"
	},
	"license": "MIT",
	"author": {
		"name": "Swarnil",
		"url": "https://imswarnil.com"
	},
	"type": "module",
	"sideEffects": ["*.css"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "src", "README.md"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\" 2>/dev/null || echo 'no tests yet'",
		"clean": "rm -rf dist .turbo *.tsbuildinfo"
	},
	"dependencies": {
		"@creatorkit/ui": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18"
	}
}
