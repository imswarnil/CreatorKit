{
	"name": "@creatorkit/ui",
	"version": "0.1.0",
	"description": "CreatorKit component library \u2014 accessible React components styled with Tailwind and CVA.",
	"keywords": [
		"ui-kit",
		"react",
		"components",
		"tailwind",
		"accessible",
		"design-system"
	],
	"homepage": "https://creator.imswarnil.com",
	"bugs": "https://github.com/imswarnil/CreatorKit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imswarnil/CreatorKit.git",
		"directory": "packages/ui"
	},
	"license": "MIT",
	"author": {
		"name": "Swarnil",
		"url": "https://imswarnil.com"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./css": "./dist/ck-classes.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"INVENTORY.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && RECIPE_INVENTORY=INVENTORY.md node ../../tools/recipe-to-css/index.mjs dist/index.js dist/.ck-apply.css && tailwindcss -i dist/.ck-apply.css -o dist/ck-classes.css",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "node --test \"dist/**/*.test.js\"",
		"clean": "rm -rf dist .turbo *.tsbuildinfo"
	},
	"dependencies": {
		"@creatorkit/core": "workspace:*",
		"@creatorkit/tokens": "workspace:*",
		"class-variance-authority": "^0.7.0"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"tailwindcss": "^3.4.17"
	}
}
