{
	"name": "@creatorkit/docs",
	"version": "0.1.0",
	"private": true,
	"description": "creator.imswarnil.com \u2014 the CreatorKit documentation site.",
	"type": "module",
	"scripts": {
		"dev": "npm run props && npm run kit && npm run archive && next dev --port 3400",
		"build": "npm run props && npm run kit && npm run archive && next build",
		"start": "next start --port 3400",
		"lint": "eslint app components lib",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf .next dist .turbo public/archive",
		"props": "node ../../tools/props-gen/index.mjs ../../packages/ui/src lib/props.generated.json",
		"kit": "test -d ../../_legacy/docs && node ../../tools/kit-docs/index.mjs ../../_legacy/docs lib/kit.generated.json || echo \"kit-docs: _legacy/docs is gone \u2014 using the committed lib/kit.generated.json\"",
		"archive": "node ../../tools/kit-archive/index.mjs ../../_legacy public/archive"
	},
	"dependencies": {
		"@creatorkit/core": "workspace:*",
		"@creatorkit/tokens": "workspace:*",
		"@creatorkit/ui": "workspace:*",
		"next": "^14.2.15",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"@creatorkit/collections": "workspace:*",
		"@creatorkit/broadcast": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.17",
		"postcss-import": "^16.1.0"
	}
}
